{
  "name": "cowworker",
  "version": "0.2.15",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs frontend",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "node scripts/build.mjs tauri",
    "test": "vitest run frontend",
    "test:core": "cargo test -p cowworker-core",
    "test:e2e": "playwright test",
    "test:native": "node scripts/native-smoke.mjs",
    "format:check": "prettier --check frontend tests scripts *.json *.ts",
    "check": "npm run build && npm test && npm run test:core"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^26.5.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "8.3.0",
    "vitest": "^4.0.0"
  }
}
